{
  "name": "@codemastersolutions/codedev",
  "version": "0.0.6",
  "description": "CodeDev CLI - Developer tools with zero runtime dependencies.",
  "license": "MIT",
  "author": "CodeMaster Soluções",
  "repository": {
    "type": "git",
    "url": "https://github.com/codemastersolutions/codedev"
  },
  "homepage": "https://github.com/codemastersolutions/codedev",
  "bugs": {
    "url": "https://github.com/codemastersolutions/codedev/issues"
  },
  "bin": {
    "codedev": "./dist/cjs/cli.js",
    "cdev": "./dist/cjs/cli.js"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    },
    "./cli": "./dist/cjs/cli.js"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build": "pnpm run clean && pnpm run build:cjs && pnpm run build:esm",
    "lint": "eslint --ext .ts src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "commit": "pnpm run commitzero commit -a",
    "commit:push": "pnpm run commitzero commit -a -p",
    "commitzero": "commitzero",
    "commitzero:install": "pnpm exec commitzero install-hooks",
    "commitzero:uninstall": "pnpm exec commitzero uninstall-hooks"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@codemastersolutions/commitzero": "^0.0.55",
    "@types/node": "^26.6.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-istanbul": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "npm-check-updates": "^23.1.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
